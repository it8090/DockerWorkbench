{
  "name": "docker-workbench",
  "version": "0.1.5",
  "description": "Docker desktop workspace built with Tauri, React and Go",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config ui/vite.config.ts",
    "build": "tsc --noEmit && vite build --config ui/vite.config.ts",
    "test": "vitest run",
    "desktop:dev": "node scripts/build-core.mjs && tauri dev",
    "desktop:build": "node scripts/build-core.mjs && tauri build",
    "core:build": "node scripts/build-core.mjs",
    "core:test": "cd core && go test -race ./...",
    "check": "npm run build && npm run test && npm run core:test",
    "format:check": "prettier --check ui/src scripts/build-core.mjs ui/vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.11.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.14.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/it8090/DockerWorkbench.git"
  },
  "homepage": "https://github.com/it8090/DockerWorkbench",
  "bugs": {
    "url": "https://github.com/it8090/DockerWorkbench/issues"
  }
}
